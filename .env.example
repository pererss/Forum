# ————— База данных: TiDB Cloud, PostgreSQL Compatible —————
# Панель TiDB Cloud → кластер → Connect → тип подключения PostgreSQL.
DATABASE_HOST=your-cluster.gateway01.<region>.prod.aws.pg.tidbcloud.com
DATABASE_PORT=5432
DATABASE_NAME=your-database-name
DATABASE_USER=your-username
DATABASE_PASSWORD=your-password

# Альтернатива компонентам выше: полная строка подключения.
# Если задана — имеет приоритет. Никогда не коммитьте реальное значение.
# DATABASE_URL=postgres://user:password@host:5432/database

# Схема по умолчанию. Тесты используют отдельную схему (nuffy_test).
DATABASE_SCHEMA=public

# ————— Сервер —————
PORT=4000
NODE_ENV=development
# Дополнительные разрешённые источники для CORS/Origin-проверки (через запятую).
# ALLOWED_ORIGINS=

# ————— Администраторы —————
# Email-адреса (в нижнем регистре, через запятую) пользователей, получающих роль admin.
# Заполняется вручную. Не записывайте в репозиторий реальные адреса.
ADMIN_EMAILS=

# ————— Google OAuth (заполнить позже) —————
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID.
# Redirect URI: http://localhost:4000/api/auth/google/callback (для продакшена — свой домен).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SESSION_TTL_DAYS=14

# ————— Режим разработки —————
# Разрешает тестовый вход (создание локальных пользователей) ТОЛЬКО вне production.
ENABLE_DEV_LOGIN=false
